MASR_ENVIRONMENT=development
MASR_HOST=127.0.0.1
MASR_PORT=8000

MASR_ASR_MODEL_PATH=Qwen/Qwen3-ASR-1.7B
MASR_FORCED_ALIGNER_MODEL_PATH=
MASR_DEVICE_MAP=cuda:0
MASR_DTYPE=bfloat16
MASR_MAX_INFERENCE_BATCH_SIZE=1
MASR_MAX_NEW_TOKENS=256

MASR_DATA_ROOT=/home/jiangsongbo/data/multi-agent-asr
MASR_RUN_ROOT=/home/jiangsongbo/runs/multi-agent-asr
MASR_DATABASE_PATH=/home/jiangsongbo/data/multi-agent-asr/state/memory.sqlite3
MASR_RECENT_UTTERANCE_LIMIT=5
MASR_MAX_CONTEXT_CHARS=2000
